<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/helpdesk_bg"
    tools:context=".modules.training_module.ui.activities.HelpDeskactivity">

    <RelativeLayout
        android:id="@+id/iv_backView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/iv_back"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            android:layout_margin="@dimen/size_8"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left_white_24dp" />

        <com.ariston.training_module.utility.widgets.RobotoTextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_40"
            android:layout_margin="@dimen/size_8"
            android:layout_toRightOf="@+id/iv_back"
            android:gravity="center_vertical"
            android:text="@string/back"
            android:textColor="@android:color/white"
            android:textSize="@dimen/font_24" />

        <com.ariston.training_module.utility.widgets.RobotoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_back"
            android:layout_marginStart="-12dp"
            android:layout_marginBottom="@dimen/size_35"
            android:layout_toEndOf="@id/iv_back"
            android:gravity="center|start"
            android:text="HelpDesk"
            android:textColor="@android:color/white"
            android:textSize="@dimen/font_30" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_backView"
        android:layout_marginTop="@dimen/font_30"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/resultView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/font_30"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_resultprogress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cv_resultView"
                android:layout_marginLeft="@dimen/size_15"
                android:layout_marginTop="@dimen/size_40"
                android:layout_marginRight="@dimen/size_15"
                android:layout_marginBottom="@dimen/size_10"
                android:layout_weight="1"
                android:padding="@dimen/size_10"
                app:cardBackgroundColor="#fff"
                app:cardCornerRadius="15dp"
                app:cardElevation="@dimen/size_5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/size_10">

                    <ImageButton
                        android:id="@+id/iv_call"
                        android:layout_width="@dimen/size_30"
                        android:layout_height="@dimen/size_30"
                        android:layout_margin="@dimen/size_8"
                        android:adjustViewBounds="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/call_icon" />


                    <com.ariston.training_module.utility.widgets.RobotoTextView
                        android:id="@+id/score"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/scorepercentage_tr"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Give us a Call"
                        android:textColor="@color/training_blue"
                        android:textSize="24sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.ariston.training_module.utility.widgets.RobotoTextView
                        android:id="@+id/scoredes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/score"
                        android:layout_marginBottom="@dimen/size_10"
                        android:gravity="center"
                        android:text="Talk to us over Phone for additional help."
                        android:textColor="@color/training_blue"
                        android:textSize="10sp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#D30C2F"
                        app:cardCornerRadius="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp">

                            <com.ariston.training_module.utility.widgets.RobotoTextView
                                android:id="@+id/tv_call"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"

                                android:textColor="#fff"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>


            </androidx.cardview.widget.CardView>

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/mailView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10"
            android:visibility="visible">

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cv_resultView"
                android:layout_marginLeft="@dimen/size_15"
                android:layout_marginTop="@dimen/size_40"
                android:layout_marginRight="@dimen/size_15"
                android:layout_marginBottom="@dimen/size_10"
                android:layout_weight="1"
                android:padding="@dimen/size_10"
                app:cardBackgroundColor="#fff"
                app:cardCornerRadius="15dp"
                app:cardElevation="@dimen/size_5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/size_10">

                    <ImageButton
                        android:id="@+id/iv_gmail"
                        android:layout_width="@dimen/size_30"
                        android:layout_height="@dimen/size_30"
                        android:layout_margin="@dimen/size_8"
                        android:adjustViewBounds="true"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gmail_icon" />


                    <com.ariston.training_module.utility.widgets.RobotoTextView
                        android:id="@+id/writeus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/scorepercentage_tr"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Write us"
                        android:textColor="@color/training_blue"
                        android:textSize="24sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.ariston.training_module.utility.widgets.RobotoTextView
                        android:id="@+id/writedes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/score"
                        android:layout_marginBottom="@dimen/size_10"
                        android:gravity="center"
                        android:text="Write us an Email, We will connect you directly."
                        android:textColor="@color/training_blue"
                        android:textSize="10sp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/mail_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="10dp"
                        app:cardBackgroundColor="#D30C2F"
                        app:cardCornerRadius="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp">

                            <com.ariston.training_module.utility.widgets.RobotoTextView
                                android:id="@+id/mail_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textColor="#fff"
                                android:textSize="12sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>


            </androidx.cardview.widget.CardView>

        </RelativeLayout>


    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_noDataContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:cardElevation="10dp">

        <com.ariston.training_module.utility.widgets.RobotoTextView
            android:id="@+id/rtv_errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#fff"
            android:drawableEnd="@drawable/sad_face"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="No Data Found"
            android:textColor="#000" />
    </androidx.cardview.widget.CardView>


    <ProgressBar
        android:id="@+id/pbload"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/size_10" />

</RelativeLayout>