<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ebdc76" />

            <stroke android:width="1dp" android:color="#6a3ab2" />

            <corners android:radius="05dp" />

            <padding android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="1dp" />
        </shape>        
        </item>
        <item android:state_focused="true">
        <shape>
            <solid android:color="#ebdc76" />

            <stroke android:width="1dp" android:color="#6a3ab2" />

            <corners android:radius="05dp" />

            <padding android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="1dp" />
        </shape>        
        </item>
    <item>
        <shape>
            <gradient android:angle="270" android:endColor="#6a3ab2" android:startColor="#a276eb" />

            <stroke android:width="1dp" android:color="#6a3ab2" />

            <corners android:radius="05dp" />

            <padding android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="1dp" />
        </shape>        
        </item>

</selector>
