<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">


    <!--visibility:Gone-->


    <ScrollView
        android:id="@+id/scrv_cont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/ten">



            <!--visibility:Gone-->
            <LinearLayout
                android:id="@+id/lytdemestrotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lyt_body"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/TextView015"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/domenstration"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black" />

                <Spinner
                    android:id="@+id/tbxdemonst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/lyt_sale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/lytdemestrotion"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="180dp"
                    android:layout_height="@dimen/size_50"
                    android:layout_below="@+id/result"
                    android:layout_gravity="right"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:id="@+id/btn_recent_entries1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#147f84"
                    app:cardCornerRadius="10dp">

                    <Button
                        android:id="@+id/btn_recent_entries"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/transparent"
                        android:text="Same as Previous"
                        android:textSize="14sp"
                        android:visibility="visible" />
                </androidx.cardview.widget.CardView>


                <!--visibility:Gone-->
                <!--visibility:Gone-->


                <TextView
                    android:id="@+id/model1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="Category"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_below="@+id/result"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#fff"
                    app:cardCornerRadius="8dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                            android:id="@+id/searchableSpinner_spsubcat"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="10dp"
                            android:visibility="visible"
                            android:background="@null"
                            android:padding="5dp" />



                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/model13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/spsubcat"
                    android:layout_alignParentLeft="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="Sub Category"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#fff"
                    app:cardCornerRadius="8dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                            android:id="@+id/searchableSpinner_spmodels"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="10dp"
                            android:background="@null"
                            android:visibility="visible"
                            android:padding="5dp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txt_Sku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="@dimen/size_10"
                    android:layout_marginEnd="10dp"
                    android:text="Model"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="12dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_below="@+id/result"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="@dimen/size_10"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#fff"
                    app:cardCornerRadius="8dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                            android:id="@+id/searchableSpinner_spproducts"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:background="@null"
                            android:visibility="visible"
                            android:padding="5dp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <!--<TextView
                    android:id="@+id/txt_mop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MOP"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                     />

                <EditText
                    android:id="@+id/edtxt_mop"
                    android:layout_width="match_parent"
                    android:textColor="#000000"
                    android:maxLength="15"
                    android:layout_height="wrap_content" />-->







                <TextView
                    android:id="@+id/TextView017"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Bar Code Scanner"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/size_5"
                    android:background="@color/transparent"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"

                        android:layout_weight="1.5"
                        app:cardBackgroundColor="#fff"
                        app:cardCornerRadius="8dp">

                        <TextView
                            android:id="@+id/tbxInvoiceNumber"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:ems="10"
                            android:gravity="center_vertical"
                            android:hint="Enter Bar Code Scanner"
                            android:inputType="number|numberSigned"
                            android:paddingLeft="@dimen/size_10" />
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:id="@+id/scann"
                        android:layout_gravity="center"
                        android:layout_weight=".5"
                        android:layout_marginStart="10dp"


                        app:cardBackgroundColor="#fff"
                        app:cardCornerRadius="8dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/size_10"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="15dp"

                                android:layout_gravity="center"
                                android:src="@drawable/scan"
                                android:layout_height="15dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scan"
                                android:textSize="@dimen/font_12"
                                android:gravity="center"
                                android:textColor="#147f84"/>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>



                <LinearLayout
                    android:id="@+id/rll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"></LinearLayout>


                <!--visibility:Gone-->
                <LinearLayout
                    android:id="@+id/lnr_invoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="@color/black" />

                </LinearLayout>





                <androidx.cardview.widget.CardView
                    android:layout_width="200dp"
                    android:layout_height="@dimen/size_50"
                    android:layout_below="@+id/result"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#147f84"
                    app:cardCornerRadius="10dp">

                    <Button
                        android:id="@+id/btn_submit_sale"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/transparent"
                        android:text="Save"
                        android:textSize="18sp"
                        android:visibility="visible" />
                </androidx.cardview.widget.CardView>


            </LinearLayout>

        </RelativeLayout>
    </ScrollView>

</RelativeLayout>