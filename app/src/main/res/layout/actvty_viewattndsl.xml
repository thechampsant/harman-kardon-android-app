<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/view_attendance_current_user_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/linear_lyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view_attendance_current_user_textview"
        android:orientation="vertical">


        <RelativeLayout
            android:id="@+id/linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <androidx.cardview.widget.CardView

                android:layout_width="@dimen/size_150"
                android:layout_height="@dimen/size_50"

                android:layout_margin="@dimen/size_5"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/size_5">

                <!--<LinearLayout
                    android:id="@+id/rllheadersalespage"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_50"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:visibility="visible">-->

                <!-- <TextView
                     android:id="@+id/from_date"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="From Date:"
                     android:textAppearance="?android:attr/textAppearanceMedium"
                     android:textColor="@color/Black" />-->

                <RelativeLayout

                    android:id="@+id/lyt_start_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/size_10"
                    android:layout_marginEnd="@dimen/size_10"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_for_dates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"

                        android:text="Start Date"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                    <ImageView
                        android:id="@+id/btn_for_dates"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentEnd="true"

                        android:alpha="0.5"
                        android:paddingLeft="@dimen/padtext"
                        android:src="@drawable/ic_calendar_plan" />
                </RelativeLayout>
                <!--     </LinearLayout>-->

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView

                android:layout_width="@dimen/size_150"
                android:layout_height="@dimen/size_50"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/size_5"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/size_5">

                <!--     <LinearLayout
                         android:id="@+id/rllsalespage"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"

                         android:gravity="center_horizontal"
                         android:orientation="vertical"
                         android:padding="5dp">-->

                <!-- <TextView
                     android:id="@+id/todate_text"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="To Date:"
                     android:textAppearance="?android:attr/textAppearanceMedium"
                     android:textColor="@color/Black" />-->

                <RelativeLayout
                    android:id="@+id/lyt_end_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/size_10"
                    android:layout_marginEnd="@dimen/size_10"

                    >

                    <TextView
                        android:id="@+id/txt_to_dates"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:gravity="end|center_vertical"
                        android:paddingRight="3dp"
                        android:text="End Date"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                    <ImageView

                        android:id="@+id/btn_to_dates"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:alpha="0.5"
                        android:paddingLeft="@dimen/padtext"
                        android:src="@drawable/ic_calendar_plan" />
                </RelativeLayout>
                <!-- </LinearLayout>-->

            </androidx.cardview.widget.CardView>


        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/size_10">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableLayout
                    android:id="@+id/table_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <TableRow
                        android:id="@+id/tableRow1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/textView1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape"
                            android:padding="5dp"
                            android:text="Date"
                            android:gravity="center"
                            android:textColor="#fff"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape"
                            android:padding="5dp"
                            android:text="Attendance"
                            android:gravity="center"
                            android:textColor="#fff"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape"
                            android:padding="5dp"
                            android:text="Mark IN"
                            android:gravity="center"
                            android:textColor="#fff"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape"
                            android:padding="5dp"
                            android:text="Mark Out"
                            android:gravity="center"
                            android:textColor="#fff"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape"
                            android:padding="5dp"
                            android:text="Working Hours"
                            android:textColor="#fff"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cell_shape"
                            android:padding="5dp"
                            android:text="Action"
                            android:textColor="#fff"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
        </ScrollView>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/White"
            android:dividerHeight="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rel2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:background="#FFFFFFFF"
        android:visibility="gone">

        <ListView
            android:id="@+id/listview_Second"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rel3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_bck"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/ic_launcher" />
    </RelativeLayout>

</RelativeLayout>