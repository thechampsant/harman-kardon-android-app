<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ffffff">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_10"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="@dimen/size_5">

        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/arrow"
                android:visibility="gone" />

            <!-- City -->
            <!-- Weather Information -->

            <LinearLayout
                android:id="@+id/llp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="17dp"
                    android:src="@drawable/notupdated"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/lli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:padding="5dp">

                        <TextView
                            android:id="@+id/myproductname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:maxWidth="190dp"
                            android:text="Product Name"
                            android:textColor="#040404"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:typeface="sans" />

                        <ImageView
                            android:id="@+id/myimg"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom"
                            android:layout_marginLeft="7dp"
                            android:src="@drawable/puimage" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tbxscat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="7dp"
                        android:text="scat"

                        android:textColor="#040404"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:typeface="sans" />

                    <TextView
                        android:id="@+id/tbxmcat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-15sp"
                        android:padding="7dp"
                        android:text="mcat"
                        android:textColor="@color/grey"
                        android:textSize="10sp"

                        android:typeface="sans" />

                    <TextView
                        android:id="@+id/tbxdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-15sp"
                        android:padding="7dp"
                        android:text="date"
                        android:textColor="@color/grey"
                        android:textSize="10sp"

                        android:typeface="sans" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/myqty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:padding="7dp"
                android:text="Quantity"
                android:textColor="@color/app_btn_color"
                android:textSize="16sp"
                android:textStyle="normal" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>


