<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <LinearLayout
        android:id="@+id/lyt_quiz_status1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:padding="@dimen/ten" >

        <TextView
            android:id="@+id/txt_quiz_serial1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1."
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/txt_quiz_status1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/padtext"
            android:text="Answered"
            android:textAppearance="?android:attr/textAppearanceMedium" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_quiz_status2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@id/lyt_quiz_status1"
        android:background="@color/quiz_pending_item"
        android:padding="@dimen/ten" >

        <TextView
            android:id="@+id/txt_quiz_serial2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2."
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/txt_quiz_status2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/padtext"
            android:text="Pending"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/quiz_pending" />

    </LinearLayout>

</RelativeLayout>
