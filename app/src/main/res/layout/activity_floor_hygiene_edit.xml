<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_150"
        android:background="@color/green">

        <ImageView
            android:id="@+id/iv_bg_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_150"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_top_home" />

        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_10"
            android:layout_marginTop="@dimen/size_20"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_back_btn"
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:rotation="270"
                app:srcCompat="@drawable/ic_chevron_left_white_24dp"
                app:tint="@color/white" />


            <com.ariston.training_module.utility.widgets.RobotoTextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_10"
                android:text="@string/back"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </LinearLayout>

        <com.ariston.training_module.utility.widgets.RobotoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/size_10"
            android:layout_marginBottom="10dp"
            android:text="Display Compliance"
            android:textColor="@color/white"
            android:textSize="@dimen/font_30" />


    </RelativeLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rlDateSelect"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40"
                android:layout_margin="@dimen/size_20"
                android:background="@drawable/rectangle_blue">


                <com.ariston.training_module.utility.widgets.RobotoTextView
                    android:id="@+id/txtDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_10"
                    android:text="Select Date" />

                <com.ariston.training_module.utility.widgets.RobotoTextView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_10"
                    android:src="@drawable/calendar_icon" />


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlChooseStore"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40"
                android:layout_below="@+id/rlDateSelect"
                android:layout_margin="@dimen/size_20"
                android:background="@drawable/rectangle_blue">


                <com.ariston.training_module.utility.widgets.RobotoTextView
                    android:id="@+id/tv_store_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_10"
                    android:text="Select Store" />

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_10"
                    android:rotation="180"
                    android:src="@drawable/arrow_upward" />


            </RelativeLayout>


            <androidx.cardview.widget.CardView

                android:id="@+id/cardChooseImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlChooseStore"
                android:layout_margin="@dimen/size_10"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/size_5">


                    <LinearLayout


                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:weightSum="3">

                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/ll_sp1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/border_green"
                                android:orientation="horizontal"
                                android:padding="@dimen/size_10"
                                android:visibility="visible">

                                <Spinner
                                    android:id="@+id/spin1Cap"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="45"
                                    android:background="@android:color/transparent"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/size_10"
                                    android:spinnerMode="dropdown" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="5"

                                    app:srcCompat="@drawable/down_arrow" />

                            </LinearLayout>


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/image1Cap"
                                android:layout_width="@dimen/size_50"
                                android:layout_height="@dimen/size_50"
                                android:layout_gravity="center"

                                android:layout_margin="@dimen/size_10"
                                android:src="@drawable/ic_camera_48dp" />


                            <com.ariston.training_module.utility.widgets.RobotoTextView
                                android:id="@+id/tv_img_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginBottom="@dimen/size_10"
                                android:text="Image 1" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout

                                android:id="@+id/ll_sp2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/border_green"
                                android:orientation="horizontal"
                                android:padding="@dimen/size_10">

                                <Spinner
                                    android:id="@+id/spin2Cap"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="45"
                                    android:background="@android:color/transparent"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/size_10"
                                    android:spinnerMode="dropdown" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="5"
                                    app:srcCompat="@drawable/down_arrow" />

                            </LinearLayout>


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/image2Cap"
                                android:layout_width="@dimen/size_50"
                                android:layout_height="@dimen/size_50"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/size_10"
                                android:src="@drawable/ic_camera_48dp" />

                            <com.ariston.training_module.utility.widgets.RobotoTextView
                                android:id="@+id/tv_img_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginBottom="@dimen/size_5"
                                android:text="Image 2" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/ll_sp3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/border_green"
                                android:orientation="horizontal"
                                android:padding="@dimen/size_10">

                                <Spinner
                                    android:id="@+id/spin3Cap"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="45"
                                    android:background="@android:color/transparent"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/size_10"
                                    android:spinnerMode="dropdown" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="5"
                                    app:srcCompat="@drawable/down_arrow" />

                            </LinearLayout>


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/image3Cap"
                                android:layout_width="@dimen/size_50"
                                android:layout_height="@dimen/size_50"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/size_10"
                                android:src="@drawable/ic_camera_48dp" />

                            <com.ariston.training_module.utility.widgets.RobotoTextView
                                android:id="@+id/tv_img_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginBottom="@dimen/size_5"
                                android:text="Image 3" />


                        </LinearLayout>


                    </LinearLayout>


                </RelativeLayout>


            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cv_save"
                android:layout_width="@dimen/size_150"
                android:layout_height="45dp"
                android:layout_below="@+id/cardChooseImages"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/size_40"

                app:cardBackgroundColor="@color/Teal"
                app:cardCornerRadius="22dp">

                <com.ariston.training_module.utility.widgets.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="SAVE"
                    android:textColor="@color/white" />


            </androidx.cardview.widget.CardView>
        </RelativeLayout>
    </ScrollView>


</RelativeLayout>