<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

     <TextView 
        android:id="@+id/view_sale_current_user_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         android:paddingLeft="@dimen/size_10"
        android:textSize="15sp"
        />
     
    <LinearLayout
        android:id="@+id/linear_lyt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/view_sale_current_user_textview"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2" >

            <LinearLayout
                android:id="@+id/rllheadersalespage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible" >
                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_resultView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_50"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#147f84"
                    app:cardCornerRadius="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|center"
                        android:paddingLeft="@dimen/size_10"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/txt_for_dates"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="From Date:"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textColor="@color/white" />

                        <LinearLayout
                            android:id="@+id/lyt_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginLeft="@dimen/size_10"
                            android:weightSum="350" >

                            <TextView
                                android:id="@+id/txt_for_dates1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="300"
                                android:text="NA"
                                android:visibility="gone"
                                android:textColor="@color/white"
                                android:textAppearance="?android:attr/textAppearanceSmall" />

                            <ImageView
                                android:id="@+id/btn_for_dates"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:paddingLeft="@dimen/padtext"
                                android:src="@drawable/date_range" />
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rllsalespage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"

                android:padding="5dp" >
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_50"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#147f84"
                    android:layout_marginRight="@dimen/size_10"
                    app:cardCornerRadius="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|center"
                        android:paddingLeft="@dimen/size_10"
                        android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txt_to_dates"
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_height="match_parent"
                        android:text="To Date:"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="@color/white" />

                    <LinearLayout
                        android:id="@+id/lyt_end_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/todate_text"
                        android:layout_marginLeft="@dimen/size_10"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:weightSum="350" >

                        <TextView
                            android:id="@+id/txt_to_dates1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="300"
                            android:gravity="right|center_vertical"
                            android:paddingRight="3dp"
                            android:visibility="gone"
                            android:text="NA"
                            android:textAppearance="?android:attr/textAppearanceSmall" />

                        <ImageView
                            android:id="@+id/btn_to_dates"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:paddingLeft="@dimen/padtext"
                            android:src="@drawable/date_range" />
                    </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/White"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rel2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:background="#FFFFFFFF"
        android:visibility="gone" >

        <ListView
            android:id="@+id/listview_Second"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rel3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" >

        <ImageView
            android:id="@+id/img_bck"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/ic_launcher" />
    </RelativeLayout>

</RelativeLayout>