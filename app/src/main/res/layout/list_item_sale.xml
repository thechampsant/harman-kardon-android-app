<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/result"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/size_5"
        android:layout_marginEnd="@dimen/size_10"
        android:layout_weight="1"
        android:padding="@dimen/size_10"
        app:cardBackgroundColor="#fff"
        app:cardCornerRadius="8dp"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/arrow"
                android:visibility="gone" />

            <!-- City -->
            <!-- Weather Information -->

            <LinearLayout
                android:id="@+id/llp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:orientation="horizontal" >

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="17dp"
                    android:src="@drawable/notupdated"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/lli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/size_10"
                    android:gravity="center_vertical"
                    android:orientation="vertical" >

                    <LinearLayout
                        android:id="@+id/ds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >

                        <TextView
                            android:id="@+id/txt_customer_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:maxWidth="190dp"
                            android:text="Customer Name"
                            android:textColor="#040404"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:typeface="sans" />
                        <TextView
                            android:id="@+id/txt_customer_Email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:maxWidth="190dp"
                            android:text="Customer Email:NA"
                            android:textColor="#040404"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:typeface="sans" />


                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_customer_mobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile No:NA"
                        android:textColor="#040404"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:typeface="sans" />



                    <TextView
                        android:id="@+id/tbxscat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="scat"
                        android:layout_marginTop="@dimen/size_10"
                        android:textColor="#040404"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:typeface="sans" />

                    <TextView
                        android:id="@+id/tbxdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"


                        android:text="date"
                        android:textColor="#040404"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:typeface="sans" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/myimg"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="gone"
                android:layout_alignParentRight="true"
                android:layout_gravity="right"
                android:layout_marginLeft="7dp"
                android:src="@drawable/puimage" />

            <!-- <TextView
                android:id="@+id/txt_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignTop="@+id/llp"
                android:padding="7dp"
                android:text="amount"
                android:textColor="#343434"
                android:textSize="18sp"
                android:textStyle="bold" /> -->

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:visibility="visible"
                android:layout_below="@id/llp"
                />
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_resultView"
                android:layout_width="wrap_content"
                android:layout_above="@+id/view1"
                android:layout_alignParentRight="true"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_marginStart="10dp"
                app:cardBackgroundColor="#147f84"
                app:cardCornerRadius="8dp"
                >

            <TextView
                android:id="@+id/txt_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/llp"
                android:layout_gravity="right|center_vertical"
                android:padding="7dp"
                android:textColor="#fff"
                android:textSize="16sp"
                android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>