<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/lv_view"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/iv_rv_tr_dsc"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/v_middle_rv_tr_desc"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/iv_rv_tr_dsc"
            android:layout_marginTop="30dp"
            android:background="@drawable/line_rv_tr_desc" />

        <TextView
            android:id="@+id/tv__label_tr_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/v_middle_rv_tr_desc"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"

            android:textColor="@color/labels_rv_training_desc" />

        <ImageView
            android:id="@+id/iv_seen"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentRight="true"
            android:visibility="gone"
            android:src="@drawable/ic_baseline_check_green_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </RelativeLayout>


</androidx.cardview.widget.CardView>