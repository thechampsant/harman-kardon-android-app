<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/size_10">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_10">

        <ImageView
            android:id="@+id/iv_rv_tr_dsc"
            android:layout_width="@dimen/size_50"
            android:layout_height="@dimen/size_50"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/v_middle_rv_tr_desc"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_2"
            android:layout_below="@+id/iv_rv_tr_dsc"
            android:layout_marginTop="@dimen/size_30"
            android:background="@drawable/line_rv_tr_desc" />

        <com.ariston.training_module.utility.widgets.RobotoBoldTextView
            android:id="@+id/tv__label_tr_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/v_middle_rv_tr_desc"
            android:layout_marginTop="@dimen/size_10"
            android:layout_marginBottom="@dimen/size_10"
            android:gravity="center"

            android:textColor="@color/labels_rv_training_desc" />

        <ImageView
            android:id="@+id/iv_seen"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentRight="true"
            android:visibility="gone"
            android:src="@drawable/ic_baseline_check_green_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </RelativeLayout>


</androidx.cardview.widget.CardView>